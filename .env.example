NODE_ENV=development

APP_ADDRESS=0.0.0.0
APP_PORT=3000
APP_PUBLIC_URL=http://localhost:3000

RESOURCES_DIR=./resources

LOG_LEVEL=info
LOG_SAMPLE_RATE=1
LOG_SLOW_REQUEST_MS=1000

TOKEN_SECRET=

COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_TTL=2592000
SESSION_CACHE_TTL=900

DATABASE_URL=postgresql://user:password@localhost:5432/teacoder
REDIS_URL=redis://localhost:6379

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=false

SMTP_FROM_HELLO=hello@teacoder.ru
SMTP_FROM_NOREPLY=no-reply@teacoder.ru

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

CRYPTO_BOT_TOKEN=
CRYPTO_BOT_TESTNET=false

NPD_INN=
NPD_PASSWORD=
# Leave empty to derive a stable id from the INN. Set it only when several
# deployments share one account — the token is bound to this value.
NPD_DEVICE_ID=
