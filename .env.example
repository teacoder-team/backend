NODE_ENV=development

APP_ADDRESS=0.0.0.0
APP_PORT=8000

CORS_ORIGIN=http://localhost:3000,https://teacoder.ru
CORS_MAX_AGE=7200

# Public URL of this API (OAuth callbacks, provider webhooks)
GATEWAY_URL=http://localhost:8000
# Public URL of the website (email links, post-payment redirects)
APP_URL=http://localhost:3000

RESOURCES_DIR=./resources

LOG_LEVEL=info
LOG_SAMPLE_RATE=1
LOG_SLOW_REQUEST_MS=1000

JWT_SECRET=
ACCESS_TOKEN_TTL=900

VERIFICATION_CODE_HASH_KEY=
MFA_ENCRYPTION_KEY=

COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_TTL=2592000
SESSION_CACHE_TTL=900

DATABASE_URL=postgresql://user:password@localhost:5432/teacoder
REDIS_URL=redis://localhost:6379

RESEND_BASE_URL=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

MAIL_FROM_HELLO=hello@teacoder.ru
MAIL_FROM_NOREPLY=no-reply@teacoder.ru
SUPPORT_EMAIL=support@teacoder.ru

ORION_API_URL=
ORION_MASTER_KEY=

# 'none' (default), 'turnstile', or 'yandex' - only the matching keys below are required.
CAPTCHA_PROVIDER=none
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
YANDEX_CAPTCHA_SECRET_KEY=
YANDEX_CAPTCHA_CLIENT_KEY=

FINGERPRINT_SECRET_KEY=
FINGERPRINT_REGION=global

WEBAUTHN_RP_ID=
# Comma-separated, e.g. https://teacoder.ru,https://app.teacoder.ru
WEBAUTHN_ORIGINS=

OAUTH_STATE_TTL=600
# Site page OAuth providers redirect back to; /<provider> is appended (register e.g.
# https://teacoder.ru/auth/callback/google in each provider console). Empty = APP_URL/auth/callback
OAUTH_CALLBACK_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=

VK_CLIENT_ID=

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD_1=
ROBOKASSA_PASSWORD_2=
ROBOKASSA_TEST_MODE=false
ROBOKASSA_TEST_PASSWORD_1=
ROBOKASSA_TEST_PASSWORD_2=
ROBOKASSA_HASH_ALGORITHM=md5

HELEKET_MERCHANT_ID=
HELEKET_PAYMENT_API_KEY=

PRODAMUS_FORM_URL=https://teacoder.payform.ru
PRODAMUS_SECRET_KEY=
PRODAMUS_DEMO_MODE=false

CRYPTO_BOT_TOKEN=
CRYPTO_BOT_TESTNET=false

TELEGRAM_PUBLIC_BOT_TOKEN=
TELEGRAM_PUBLIC_BOT_WEBHOOK_SECRET=

# Staff-only notifications bot - leave the token empty to disable it.
# Chat IDs: 123456789 (user), -1001234567890 (group), -1001234567890:42 (forum topic)
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=

NPD_INN=
NPD_PASSWORD=
# Leave empty to derive a stable id from the INN. Set it only when several
# deployments share one account - the token is bound to this value.
NPD_DEVICE_ID=