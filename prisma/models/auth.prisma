model Credential {
    id String @id @default(uuid())

    provider AuthProvider
    type     CredentialType

    identifier String

    passwordHash PasswordHash?
    resetTokens  PasswordResetToken[]

    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId String @map("user_id")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@unique([provider, identifier], map: "uq_credentials_provider_identifier")
    @@index([userId], map: "ix_credentials_user_id")
    @@map("credentials")
}

model PasswordHash {
    hash      String
    algorithm String
    version   Int

    credential   Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
    credentialId String     @id @map("credential_id")

    @@map("password_hashes")
}

model PasswordResetToken {
    id String @id @default(uuid())

    token     String              @unique(map: "uq_password_reset_tokens_token")
    status    PasswordResetStatus @default(PENDING)
    expiresAt DateTime            @map("expires_at")

    credential   Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
    credentialId String     @map("credential_id")

    @@index([status, expiresAt], map: "ix_password_reset_tokens_status_expires_at")
    @@map("password_reset_tokens")
}

enum AuthProvider {
    EMAIL    @map("email")
    GOOGLE   @map("google")
    GITHUB   @map("github")
    DISCORD  @map("discord")
    TELEGRAM @map("telegram")
    YANDEX   @map("yandex")
    GITLAB   @map("gitlab")

    @@map("account_providers")
}

enum CredentialType {
    PASSWORD @map("password")
    OAUTH    @map("oauth")

    @@map("credential_types")
}

enum PasswordResetStatus {
    PENDING @map("pending")
    USED    @map("used")
    EXPIRED @map("expired")

    @@map("password_reset_statuses")
}
