model Credential {
    id String @id @default(uuid())

    provider AuthProvider
    type     CredentialType

    identifier String

    passwordHash PasswordHash?
    resetTokens  PasswordResetToken[]

    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId String @map("user_id")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@unique([provider, identifier], map: "uq_credentials_provider_identifier")
    @@index([userId], map: "ix_credentials_user_id")
    @@map("credentials")
}

model PasswordHash {
    hash      String
    algorithm String
    version   Int

    credential   Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
    credentialId String     @id @map("credential_id")

    @@map("password_hashes")
}

model PasswordResetToken {
    id String @id @default(uuid())

    token     String              @unique
    status    PasswordResetStatus @default(PENDING)
    expiresAt DateTime            @map("expires_at")

    credential   Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
    credentialId String     @map("credential_id")

    @@index([status, expiresAt], map: "ix_password_reset_tokens_status_expires_at")
    @@map("password_reset_tokens")
}

enum AuthProvider {
    EMAIL
    GOOGLE
    GITHUB
    DISCORD
    TELEGRAM
    YANDEX
    GITLAB

    @@map("account_providers")
}

enum CredentialType {
    PASSWORD
    OAUTH
}

enum PasswordResetStatus {
    PENDING
    USED
    EXPIRED
}
