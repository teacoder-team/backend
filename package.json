{
	"name": "@teacoder/backend",
	"type": "module",
	"scripts": {
		"dev": "bun --watch src/main.ts",
		"build": "bun build ./src/main.ts --outdir ./dist --target bun --minify --sourcemap",
		"start": "bun dist/main.js",
		"email:dev": "email dev --dir ./emails -p 3001",
		"db:generate": "bunx prisma generate",
		"db:push": "bunx prisma db push"
	},
	"dependencies": {
		"@elysiajs/openapi": "^1.4.14",
		"@prisma/adapter-pg": "^7.7.0",
		"@prisma/client": "^7.7.0",
		"@react-email/components": "^1.0.12",
		"@react-email/render": "^2.0.7",
		"@sinclair/typebox": "^0.34.49",
		"argon2": "^0.44.0",
		"elysia": "^1.4.28",
		"ioredis": "^5.10.1",
		"maxmind": "^5.0.6",
		"nodemailer": "^8.0.5",
		"pino": "^10.3.1",
		"prisma": "^7.7.0",
		"react": "^19.2.5",
		"react-dom": "^19.2.5",
		"slugify": "^1.6.9",
		"ua-parser-js": "^2.0.9"
	},
	"devDependencies": {
		"@react-email/preview-server": "5.2.10",
		"@react-email/ui": "^6.0.0",
		"@types/nodemailer": "^8",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"bun-types": "latest",
		"pino-pretty": "^13.1.3",
		"react-email": "^6.0.0",
		"typescript": "^6.0.3"
	}
}
