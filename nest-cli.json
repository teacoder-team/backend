{
	"$schema": "https://json.schemastore.org/nest-cli",
	"collection": "@nestjs/schematics",
	"sourceRoot": "src",
	"compilerOptions": {
		"deleteOutDir": true,
		"builder": {
			"type": "swc",
			"options": {
				"configFile": ".swcrc",
				"swcrc": true,
				"extensions": [".ts", ".tsx"]
			}
		},
		"typeCheck": true
	}
}
